rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in user's pointer to which shared space (identified by its
    // owner's uid) their expenses currently live under. Defaults to their own
    // uid on the client when this doc doesn't exist (a normal solo user).
    // Fully self-owned: only that uid can read or write their own pointer.
    match /memberships/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // One-time invite codes that bridge joining someone else's shared space.
    // Any signed-in user may read one to check it's valid before joining.
    // Only a current member of a space (its owner, or anyone whose
    // memberships pointer already resolves to it) may create an invite for
    // it. Claiming one may only flip used:false -> true and record who
    // claimed it — the spaceId it points to can never change, and it can't
    // be un-claimed once used.
    match /invites/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.used == false
        && (
          request.auth.uid == request.resource.data.spaceId ||
          (exists(/databases/$(database)/documents/memberships/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.spaceId == request.resource.data.spaceId)
        );
      allow update: if request.auth != null
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.spaceId == resource.data.spaceId
        && request.resource.data.claimedBy == request.auth.uid;
    }

    // The actual shared expense data (settings, each month's items, and the
    // "members" doc used to display who's currently sharing this space).
    // Readable/writable by the space's own uid, or by anyone whose
    // memberships pointer currently resolves to this spaceId.
    match /data/users/{spaceId}/{document=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == spaceId ||
        (exists(/databases/$(database)/documents/memberships/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/memberships/$(request.auth.uid)).data.spaceId == spaceId)
      );
    }
  }
}
