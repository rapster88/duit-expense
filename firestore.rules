rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own data, under
    // data/users/<their uid>/... (matches the paths index.html writes to:
    // ".../settings" and ".../m-<YYYY-MM>").
    match /data/users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
